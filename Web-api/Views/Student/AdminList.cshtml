function editItem(studentId) {
    if (!studentId) return;

    // Gọi Ajax để lấy thông tin chi tiết học sinh từ server
    $.ajax({
        url: `/student/api/detail/${studentId}`,
        type: "GET",
        success: function (res) {
            if (res) {
                // 1. Reset form và xóa các thông báo lỗi cũ
                studentForm.reset();
                clearStudentFormErrors();

                // 2. Điền Id học sinh vào ô ẩn (hidden input)
                document.getElementById('studentId').value = studentId;

                // 3. Điền các thông tin cá nhân vào các ô nhập
                $("#studentName").val(res.name);
                $("#studentCitizenId").val(res.citizenId);
                $("#studentPhone").val(res.phoneNumber);
                $("#studentEmail").val(res.email);
                $("#studentAddress").val(res.address);
                $("#studentCourse").val(res.course);
                
                // Điền Tỉnh/Thành phố và Xã/Phường
                if (res.provinceId) {
                    $("#studentProvince").val(res.provinceId).trigger('change', [res.wardId]);
                } else {
                    $("#studentProvince").val(null).trigger('change');
                }

                // Điền Lớp học
                if (res.schoolClassId) {
                    $("#studentClass").val(res.schoolClassId).trigger('change');
                } else {
                    $("#studentClass").val(null).trigger('change');
                }
                
                // Điền trạng thái Bảo lưu (Checkbox)
                $("#studentIsRetained").prop("checked", res.isRetained);

                // Điền Giới tính (sử dụng thư viện Select2)
                $("#studentGender").val(res.gender).trigger('change');

                // 4. Định dạng ngày sinh từ yyyy-mm-dd sang dd-mm-yyyy để Flatpickr hiển thị đúng
                if (res.birthDay) {
                    const date = new Date(res.birthDay);
                    const day = String(date.getDate()).padStart(2, '0');
                    const month = String(date.getMonth() + 1).padStart(2, '0');
                    const year = date.getFullYear();
                    $("#studentBirthDay").val(`${day}-${month}-${year}`);
                }

                // 5. Hiển thị ảnh đại diện cũ (nếu có)
                const avatarUrl = res.image && res.image !== "default-avatar.png" ? res.image : "";
                avatarPreview.src = avatarUrl;
                document.getElementById('imagePath').value = res.image || "";

                // 6. Đổi giao diện Modal sang chế độ Cập nhật
                document.getElementById('modalTitle').textContent = 'Cập Nhật Thông Tin Học Sinh';
                document.getElementById('btnSubmitModal').textContent = 'Cập nhật';

                // 7. Mở Modal hiển thị lên màn hình
                modal.classList.add('open');
            }
        },
        error: function (xhr) {
            Swal.fire({
                icon: 'error',
                title: 'Lỗi',
                text: 'Không thể tải thông tin học sinh để chỉnh sửa.',
                confirmButtonColor: '#d33'
            });
        }
    });
}


        // Avatar Preview URL Listener
        imagePathInput.addEventListener('input', (e) => {
            const val = e.target.value.trim();
            avatarPreview.src = val !== "" ? val : "";
        });

        // Click Upload Box triggers file input
        uploadBox.addEventListener('click', () => {
            imageInput.click();
        });

        // Avatar Local File Selection Preview
        imageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    avatarPreview.src = evt.target.result;
                    imagePathInput.value = evt.target.result; // Put base64 in text input for form data collection
                }
                reader.readAsDataURL(file);
            }
        });

        function deleteItem(id) {
            if (!id) return;

            Swal.fire({
                title: 'Xác nhận xóa?',
                text: "Bạn có chắc chắn muốn xóa học sinh này? Hành động này không thể hoàn tác!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Đồng ý xóa',
                cancelButtonText: 'Hủy'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: `/student/api/delete/${id}`,
                        type: "DELETE",
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Thành công',
                                    text: response.message || 'Xóa học sinh thành công!',
                                    confirmButtonColor: '#3085d6',
                                    confirmButtonText: 'OK'
                                }).then(() => {
                                    if (table) {
                                        table.ajax.reload(null, false);
                                    } else {
                                        location.reload();
                                    }
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Thất bại',
                                    text: response.message || 'Không thể xóa học sinh.',
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Đóng'
                                });
                            }
                        },
                        error: function (xhr) {
                            let errorMsg = 'Đã xảy ra lỗi hệ thống hoặc không thể kết nối tới server.';
                            if (xhr.responseJSON && xhr.responseJSON.message) {
                                errorMsg = xhr.responseJSON.message;
                            }
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi',
                                text: errorMsg,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Đóng'
                            });
                            console.error(xhr.responseText);
                        }
                    });
                }
            });
        }
    </script>
