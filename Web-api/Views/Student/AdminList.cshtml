@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh Sách Học Sinh - Admin";
}

<style>

    .dt-custom-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 18px;
        background: #fff;
    }

    .dt-footer-left,
    .dt-footer-info,
    .dt-footer-right {
        display: flex;
        align-items: center;
    }

        .dt-footer-left label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #475569;
            font-size: 14px;
        }

        .dt-footer-left select {
            height: 36px;
            padding: 4px 28px 4px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: #fff;
            outline: none;
        }

        .dt-footer-info .dataTables_info {
            padding: 0 !important;
            color: #475569;
            font-size: 14px;
        }

        .dt-footer-right .dataTables_paginate {
            padding: 0 !important;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .dt-footer-right .dataTables_paginate .paginate_button {
                min-width: 36px;
                height: 36px;
                padding: 7px 12px !important;
                border: 1px solid #dbe3ef !important;
                border-radius: 8px !important;
                background: #fff !important;
                color: #334155 !important;
                cursor: pointer;
                margin: 0 !important;
            }

                .dt-footer-right .dataTables_paginate .paginate_button:hover {
                    background: #f1f5f9 !important;
                    border-color: #cbd5e1 !important;
                    color: #0f172a !important;
                }

                .dt-footer-right .dataTables_paginate .paginate_button.current {
                    background: #2563eb !important;
                    border-color: #2563eb !important;
                    color: #fff !important;
                }

                .dt-footer-right .dataTables_paginate .paginate_button.disabled {
                    opacity: 0.45;
                    cursor: not-allowed;
                }

    .btn-action {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 16px;
    }

        .btn-action:hover {
            background: #f1f5f9;
        }

    .btn-edit {
        color: #f59e0b;
    }

        .btn-edit:hover {
            background: #fef3c7;
        }

    .btn-delete {
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #fee2e2;
        }

    .btn-detail {
        color: #3b82f6;
    }

        .btn-detail:hover {
            background: #dbeafe;
        }

    .form-control-static {
        padding: 10px 14px;
        border-radius: var(--radius-md);
        border: 1px solid var(--border);
        background-color: var(--bg-main);
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        min-height: 43px;
        display: flex;
        align-items: center;
    }

    .text-center {
        text-align: center !important;
    }
    .text-left {
        text-align: left !important;
    }
    .text-right {
        text-align: right !important;
    }
    .text-nowrap {
        white-space: nowrap !important;
    }
    .badge-danger {
        background-color: var(--danger-light) !important;
        color: var(--danger) !important;
    }

</style>

<div class="dashboard-container">
    
    <!-- Header -->
    <header class="header-section">
        <div class="header-info">
            <h1>Hệ Thống Quản Lý Học Sinh</h1>
            <p>Xem danh sách, tìm kiếm và thêm mới thông tin học sinh trong cơ sở dữ liệu.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="openAddModal()">
                <i class="fa-solid fa-plus"></i> Thêm Học Sinh Mới
            </button>
        </div>
    </header>

    <!-- Stats Grid Widgets -->
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statTotal">0</div>
                <div class="stat-label">Tổng số học sinh</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statActive">0</div>
                <div class="stat-label">Học sinh đang học</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statRetained">0</div>
                <div class="stat-label">Học sinh bảo lưu</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon teal">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statClasses">0</div>
                <div class="stat-label">Lớp học hiện có</div>
            </div>
        </div>
    </section>

    <!-- Search & Filter Card -->
    <section class="filter-card">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Tìm kiếm theo Tên, Email hoặc SĐT...">
        </div>
        <div class="filter-group">
            <select id="filterClass" class="filter-select">
                <option value="">-- Chọn lớp học --</option>
            </select>
            <select id="filterStatus" class="filter-select">
                <option value="">-- Trạng thái --</option>
                <option value="active">Đang học</option>
                <option value="retained">Bảo lưu</option>
            </select>
            <button class="btn btn-secondary" id="btnResetFilters">
                <i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại
            </button>
        </div>
    </section>

    <!-- Main Content Table Card -->
    <main class="table-card">
        <div class="table-responsive">
            <table class="custom-table" id="studentTable">
                <thead>
                    <tr>
                        <th class="text-center text-nowrap" style="width: 50px;">STT</th>
                        <th class="text-left text-nowrap">Họ và tên</th>
                        <th class="text-center text-nowrap">Lớp học</th>
                        <th class="text-center text-nowrap">CCCD</th>
                        <th class="text-center text-nowrap">Số điện thoại</th>
                        <th class="text-center text-nowrap">Giới tính</th>
                        <th class="text-center text-nowrap">Tỉnh</th>
                        <th class="text-left text-nowrap">Email</th>
                        <th class="text-center text-nowrap">Trạng thái</th>
                        <th class="text-center text-nowrap" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <!-- Hãy điền dữ liệu của bạn bằng JS tại đây -->
                </tbody>
            </table>
        </div>

        <!-- Empty State UI -->
        <div class="empty-state" id="emptyState">
            <div class="empty-state-icon">
                <i class="fa-regular fa-folder-open"></i>
            </div>
            <h3>Không tìm thấy học sinh</h3>
            <p>Không có kết quả nào phù hợp với bộ lọc tìm kiếm hiện tại.</p>
        </div>

      
    </main>
</div>

<!-- Student Form Modal (Used for both Create and Edit) -->
<div class="modal-overlay" id="studentModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTitle">Thêm Mới Học Sinh</h2>
            <button class="modal-close" onclick="closeStudentModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        
        <form id="studentForm" novalidate>
            <input type="hidden" id="studentId" name="Id">
            <div class="modal-body">
                

                <div class="form-grid">
                    <div class="form-group col-12">
                        <label class="form-label">Ảnh đại diện</label>
                        <div class="avatar-upload-container">
                            <div class="avatar-preview-wrapper">
                                <img id="avatarPreview" alt="Avatar Preview">
                            </div>
                            <div class="avatar-upload-box" id="avatarUploadBox">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <p>Nhấp vào đây để chọn ảnh hoặc nhập đường dẫn ảnh bên dưới</p>
                                <input type="file" id="imageInput" accept="image/*" style="display: none;">
                            </div>
                        </div>
                        <input type="text" class="form-control" id="imagePath" placeholder="">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Họ và tên <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentName" required placeholder=" Nhập Họ và Tên">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Ngày sinh <span style="color:var(--danger)">*</span></label>
                        <div class="input-icon-wrapper">
                            <input type="text" class="form-control" id="studentBirthDay" required placeholder="Chọn ngày sinh...">
                            <i class="fa-regular fa-calendar input-icon"></i>
                        </div>
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Giới tính</label>
                        <select id="studentGender" name="Gender" class="form-control select2" required>
                            <option value="" disabled selected hidden>Chọn giới tính</option>
                            <option value="1">Nam</option>
                            <option value="2">Nữ</option>
                            <option value="3">Khác</option>
                        </select>
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Số định danh / CCCD <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentCitizenId" required placeholder="Nhập CCCD">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Số điện thoại <span style="color:var(--danger)">*</span></label>
                        <input type="tel" class="form-control" id="studentPhone" required placeholder="Nhập số điện thoại">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Email <span style="color:var(--danger)">*</span></label>
                        <input type="email" class="form-control" id="studentEmail" required placeholder="Nhập Email">
                    </div>



                    <div class="form-group col-6">
                        <label class="form-label">Tỉnh / Thành phố <span style="color:var(--danger)">*</span></label>
                        <select id="studentProvince" name="ProvinceId" class="form-control select2" required>
                            <option value="" disabled selected hidden>Chọn Tỉnh / Thành phố</option>
                        </select>
                    </div>

                    <div class="form-group col-6">
                        <label class="form-label">Phường / Xã <span style="color:var(--danger)">*</span></label>
                        <select id="studentWard" name="WardId" class="form-control select2" required>
                            <option value="" disabled selected hidden>Chọn Phường / Xã</option>
                        </select>
                    </div>

                    <div class="form-group col-12">
                        <label class="form-label">Địa chỉ cụ thể</label>
                        <input type="text" class="form-control" id="studentAddress" placeholder="Nhập địa chỉ">
                    </div>




                    <div class="form-group col-6">
                        <label class="form-label">Khóa học <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentCourse" required placeholder="Nhập khóa học">
                    </div>

                    <div class="form-group col-6">
                        <label class="form-label">Lớp học <span style="color:var(--danger)">*</span></label>
                        <select id="studentClass" name="SchoolClassId" class="form-control select2" required>
                            <option value="" disabled selected hidden>Chọn lớp học</option>
                        </select>
                    </div>

                    <div class="form-group col-12">
                        <label class="switch-container">
                            <input type="checkbox" class="switch-input" id="studentIsRetained">
                            <span class="switch-slider"></span>
                            <span class="form-label">Học sinh bảo lưu (Bảo lưu kết quả học tập)</span>
                        </label>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeStudentModal()">Hủy</button>
                <button type="submit" class="btn btn-primary" id="btnSubmitModal">Lưu thông tin</button>
            </div>
        </form>
    </div>
</div>

<!-- Student Detail Modal -->
<div class="modal-overlay" id="detailModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2>Thông Tin Chi Tiết Học Sinh</h2>
            <button class="modal-close" onclick="closeDetailModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="modal-body">
            <div class="form-grid">
                <!-- Ảnh đại diện -->
                <div class="form-group col-12">
                    <label class="form-label">Ảnh đại diện</label>
                    <div class="avatar-preview-wrapper" style="margin: 0;">
                        <img id="detailAvatar" alt="Avatar Preview" style="width: 100px; height: 100px; border-radius: 50%; object-fit: cover;">
                    </div>
                </div>

                <!-- Họ và tên -->
                <div class="form-group col-4">
                    <label class="form-label">Họ và tên</label>
                    <div class="form-control-static" id="detailName">-</div>
                </div>

                <!-- Ngày sinh -->
                <div class="form-group col-4">
                    <label class="form-label">Ngày sinh</label>
                    <div class="form-control-static" id="detailBirthDay">-</div>
                </div>

                <!-- Giới tính -->
                <div class="form-group col-4">
                    <label class="form-label">Giới tính</label>
                    <div class="form-control-static" id="detailGender">-</div>
                </div>

                <!-- Số định danh / CCCD -->
                <div class="form-group col-4">
                    <label class="form-label">Số định danh / CCCD</label>
                    <div class="form-control-static" id="detailCitizenId">-</div>
                </div>

                <!-- Số điện thoại -->
                <div class="form-group col-4">
                    <label class="form-label">Số điện thoại</label>
                    <div class="form-control-static" id="detailPhone">-</div>
                </div>

                <!-- Email -->
                <div class="form-group col-4">
                    <label class="form-label">Email</label>
                    <div class="form-control-static" id="detailEmail">-</div>
                </div>

                <!-- Tỉnh / Thành phố -->
                <div class="form-group col-6">
                    <label class="form-label">Tỉnh / Thành phố</label>
                    <div class="form-control-static" id="detailProvince">-</div>
                </div>

                <!-- Phường / Xã -->
                <div class="form-group col-6">
                    <label class="form-label">Phường / Xã</label>
                    <div class="form-control-static" id="detailWard">-</div>
                </div>

                <!-- Địa chỉ cụ thể -->
                <div class="form-group col-12">
                    <label class="form-label">Địa chỉ cụ thể</label>
                    <div class="form-control-static" id="detailAddress">-</div>
                </div>

                <!-- Khóa học -->
                <div class="form-group col-6">
                    <label class="form-label">Khóa học</label>
                    <div class="form-control-static" id="detailCourse">-</div>
                </div>

                <!-- Lớp học -->
                <div class="form-group col-6">
                    <label class="form-label">Lớp học</label>
                    <div class="form-control-static" id="detailClassName">-</div>
                </div>

                <!-- Học sinh bảo lưu -->
                <div class="form-group col-12">
                    <label class="form-label">Trạng thái học tập</label>
                    <div style="padding: 10px 0;">
                        <span id="detailIsRetained" class="badge">-</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" onclick="closeDetailModal()">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('studentModal');
        const studentForm = document.getElementById('studentForm');
        const avatarPreview = document.getElementById('avatarPreview');
        const imagePathInput = document.getElementById('imagePath');
        const imageInput = document.getElementById('imageInput');
        const uploadBox = document.getElementById('avatarUploadBox');
        var table = null;

        $(document).ready(function() {

            initDatePicker();
            initSelect2Elements();
            loadProvincesAndClasses();
            initTable();
            initSearchEvent();

        });

        function initDatePicker() {
            flatpickr("#studentBirthDay", {
                dateFormat: "d-m-Y",
                allowInput: true,
                parseDate: (datestr, format) => {
                    if (!datestr) return null;
                    const normalized = datestr.replace(/\//g, "-");
                    return flatpickr.parseDate(normalized, "d-m-Y");
                }
            });
        }

        // Initialize Select2 Dropdowns
        function initSelect2Elements(){
            $('#studentGender').select2({
                placeholder: "Chọn giới tính",
                minimumResultsForSearch: -1,
                width: '100%',
                dropdownParent: $('#studentModal')
            });
            $('#studentProvince').select2({
                placeholder: "Chọn Tỉnh / Thành phố",
                width: '100%',
                dropdownParent: $('#studentModal')
            });
            $('#studentWard').select2({
                placeholder: "Chọn Phường / Xã",
                width: '100%',
                dropdownParent: $('#studentModal')
            });
            $('#studentClass').select2({
                placeholder: "Chọn lớp học",
                width: '100%',
                dropdownParent: $('#studentModal')
            });

            // Bind change event to load wards when province is selected
            $('#studentProvince').on('change', function() {
                const provinceId = $(this).val();
                loadWards(provinceId);
            });
        }

        function loadProvincesAndClasses() {
            // Load provinces
            $.ajax({
                url: "/student/api/provinces",
                type: "GET",
                success: function (provinces) {
                    const provinceSelect = $('#studentProvince');
                    provinces.forEach(function (p) {
                        provinceSelect.append(new Option(p.name, p.id));
                    });
                }
            });

            // Load classes
            $.ajax({
                url: "/student/api/classes",
                type: "GET",
                success: function (classes) {
                    const classSelect = $('#studentClass');
                    const filterClassSelect = $('#filterClass');
                    classes.forEach(function (c) {
                        classSelect.append(new Option(c.name, c.id));
                        filterClassSelect.append(new Option(c.name, c.id));
                    });
                }
            });
        }

        function loadWards(provinceId, selectedWardId = null) {
            const wardSelect = $('#studentWard');
            wardSelect.empty().append('<option value="" disabled selected hidden>Chọn Phường / Xã</option>');
            
            if (!provinceId) {
                wardSelect.trigger('change');
                return;
            }

            return $.ajax({
                url: `/student/api/wards/${provinceId}`,
                type: "GET",
                success: function (wards) {
                    wards.forEach(function (w) {
                        const option = new Option(w.name, w.id, false, w.id == selectedWardId);
                        wardSelect.append(option);
                    });
                    if (selectedWardId) {
                        wardSelect.val(selectedWardId);
                    }
                    wardSelect.trigger('change');
                },
                error: function (xhr) {
                    console.error("Không thể tải danh sách xã/phường", xhr);
                }
            });
        }

        
        function initSearchEvent(){

            $("#searchInput").on("keyup", function (e) {
                if(e.key === "Enter"){
                    initTable();
                }
            });
        }


        function initTable(){
            if(table) table.destroy();

            table = $("#studentTable").DataTable({
                processing: true,
                serverSide: true,
                searching: false,
                autoWidth: false,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],

                // r + t ở trên, footer ở dưới gồm: length + info + pagination
                dom: 'rt<"dt-custom-footer"<"dt-footer-left"l><"dt-footer-info"i><"dt-footer-right"p>>',

                pagingType: "simple_numbers",

                language: {
                    lengthMenu: "Hiển thị _MENU_ học sinh trên mỗi trang",
                    info: "Hiển thị từ học sinh thứ _START_ đến _END_ (Trong tổng số _TOTAL_ học sinh)",
                    emptyTable: "Không có học sinh nào trong danh sách",
                    infoEmpty: "Hiển thị 0 đến 0 của 0 học sinh",
                    infoFiltered: "",
                    paginate: {
                        first: "Đầu tiên",
                        last: "Cuối cùng",
                        next: "Trang sau",
                        previous: "Trang trước"
                    }
                },

                ajax: function (data,callback){
                    var payload = $.extend(true,{},data);
                    payload.Draw = data.draw;
                    payload.Start = data.start;
                    payload.Length = data.length;

                    if(data.order && data.order.length > 0){
                        payload.SortColumn = data.columns[data.order[0].column].data;
                        payload.SortDirection = data.order[0].dir;
                    }

                    payload.SearchText = $("#searchInput").val() || "";

                    $.ajax({
                        url: "/student/api/list-server-side",
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(payload),
                        success: function (res){
                            callback(res);
                        },
                        error: function (xhr) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thất bại',
                                text: "Đã xảy ra lỗi khi tải dữ liệu.",
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Đóng'
                            });

                            callback({
                                draw: data.draw,
                                recordsTotal:0,
                                recordsFiltered: 0,
                                data: []
                            });
                        }

                    });
                },

                columns: [
                    {
                        data: "id",
                        orderable: false,
                        className: "text-center text-nowrap",
                        render: function(d, t, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: "name", orderable: true, className: "text-left text-nowrap" },
                    { data: "className", orderable: true, className: "text-center text-nowrap" },
                    { data: "citizenId", orderable: true, className: "text-center text-nowrap" },
                    { data: "phoneNumber", orderable: true, className: "text-center text-nowrap" },
                    { data: "genderText", orderable: false, className: "text-center text-nowrap" },
                    { data: "province", orderable: true, className: "text-center text-nowrap" },
                    { data: "email", orderable: true, className: "text-left text-nowrap" },
                    {
                        data: "isRetained",
                        orderable: true,
                        className: "text-center text-nowrap",
                        render: function (d) {
                            return d 
                                ? '<span class="badge badge-danger">Bảo lưu</span>' 
                                : '<span class="badge badge-success">Đang học</span>';
                        }
                    },
                    {
                        data: "id",
                        orderable: false,
                        className: "text-center text-nowrap",
                        render: function (id) {
                            let actions = "<div class='d-flex justify-content-center align-items-center gap-2'>";
                            
                            actions += `
                                    <button type="button"
                                            onclick="viewDetail(${id})"
                                            class="btn-action btn-detail"
                                            title="Xem chi tiết">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                `;

                            actions += `
                                <button type="button"
                                        onclick="editItem(${id})"
                                        class="btn-action btn-edit"
                                        title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            `;

                            actions += `
                                <button type="button"
                                        onclick="deleteItem(${id})"
                                        class="btn-action btn-delete"
                                        title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `;

                            actions += "</div>";

                            return actions;
                        }
                    }
                ],
                order: [[1, "asc"]]



            });
        }

        function viewDetail(id) {
            if (!id) return;

            $.ajax({
                url: `/student/api/detail/${id}`,
                type: "GET",
                success: function (res) {
                if (res) {
                    // 1. Điền ảnh đại diện (kiểm tra ảnh mặc định)
                    let avatarUrl = res.image && res.image !== "default-avatar.png" ? res.image : "/images/default-avatar.png";
                    $('#detailAvatar').attr("src", avatarUrl);

                    // 2. Điền thông tin cá nhân
                    $('#detailName').text(res.name ?? "-");
                    $('#detailCitizenId').text(res.citizenId ?? "-");
                    $('#detailPhone').text(res.phoneNumber ?? "-");
                    $('#detailEmail').text(res.email ?? "-");
                    
                    // 3. Định dạng ngày sinh từ ISO string sang DD-MM-YYYY
                    if (res.birthDay) {
                        const date = new Date(res.birthDay);
                        const day = String(date.getDate()).padStart(2, '0');
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const year = date.getFullYear();
                        $('#detailBirthDay').text(`${day}-${month}-${year}`);
                    } else {
                        $('#detailBirthDay').text("-");
                    }

                    // 4. Giới tính
                    $('#detailGender').text(res.genderText ?? "Khác");

                    // 5. Điền thông tin địa chỉ
                    $('#detailProvince').text(res.province ?? "-");
                    $('#detailWard').text(res.ward ?? "-");
                    $('#detailAddress').text(res.address ?? "-");

                    // 6. Điền thông tin học tập
                    $('#detailCourse').text(res.course ?? "-");
                    $('#detailClassName').text(res.className ?? "-");

                    // 7. Xử lý hiển thị nhãn Bảo lưu / Đang học
                    const statusBadge = $('#detailIsRetained');
                    if (res.isRetained) {
                        statusBadge.text("Bảo lưu").removeClass().addClass("badge badge-danger");
                    } else {
                        statusBadge.text("Đang học").removeClass().addClass("badge badge-success");
                    }

                    // 8. Mở modal chi tiết
                    $('#detailModal').addClass("open");
                }
            },
            error: function (xhr) {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi',
                    text: 'Không thể tải thông tin chi tiết học sinh.',
                    confirmButtonColor: '#d33'
                });
            }
        });
        }

        function closeDetailModal() {
            $('#detailModal').removeClass("open");
        }




        $(document).ready(function (){

