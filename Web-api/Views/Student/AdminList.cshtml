@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Danh Sách Học Sinh - Admin";
}

<style>

    .dt-custom-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 14px 18px;
        background: #fff;
    }

    .dt-footer-left,
    .dt-footer-info,
    .dt-footer-right {
        display: flex;
        align-items: center;
    }

        .dt-footer-left label {
            margin: 0;
            display: flex;
            align-items: center;
            gap: 6px;
            color: #475569;
            font-size: 14px;
        }

        .dt-footer-left select {
            height: 36px;
            padding: 4px 28px 4px 10px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: #fff;
            outline: none;
        }

        .dt-footer-info .dataTables_info {
            padding: 0 !important;
            color: #475569;
            font-size: 14px;
        }

        .dt-footer-right .dataTables_paginate {
            padding: 0 !important;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .dt-footer-right .dataTables_paginate .paginate_button {
                min-width: 36px;
                height: 36px;
                padding: 7px 12px !important;
                border: 1px solid #dbe3ef !important;
                border-radius: 8px !important;
                background: #fff !important;
                color: #334155 !important;
                cursor: pointer;
                margin: 0 !important;
            }

                .dt-footer-right .dataTables_paginate .paginate_button:hover {
                    background: #f1f5f9 !important;
                    border-color: #cbd5e1 !important;
                    color: #0f172a !important;
                }

                .dt-footer-right .dataTables_paginate .paginate_button.current {
                    background: #2563eb !important;
                    border-color: #2563eb !important;
                    color: #fff !important;
                }

                .dt-footer-right .dataTables_paginate .paginate_button.disabled {
                    opacity: 0.45;
                    cursor: not-allowed;
                }

    .btn-action {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 8px;
        background: transparent;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 16px;
    }

        .btn-action:hover {
            background: #f1f5f9;
        }

    .btn-edit {
        color: #f59e0b;
    }

        .btn-edit:hover {
            background: #fef3c7;
        }

    .btn-delete {
        color: #ef4444;
    }

        .btn-delete:hover {
            background: #fee2e2;
        }


</style>

<div class="dashboard-container">
    
    <!-- Header -->
    <header class="header-section">
        <div class="header-info">
            <h1>Hệ Thống Quản Lý Học Sinh</h1>
            <p>Xem danh sách, tìm kiếm và thêm mới thông tin học sinh trong cơ sở dữ liệu.</p>
        </div>
        <div>
            <button class="btn btn-primary" onclick="openAddModal()">
                <i class="fa-solid fa-plus"></i> Thêm Học Sinh Mới
            </button>
        </div>
    </header>

    <!-- Stats Grid Widgets -->
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-icon blue">
                <i class="fa-solid fa-graduation-cap"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statTotal">0</div>
                <div class="stat-label">Tổng số học sinh</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon green">
                <i class="fa-solid fa-user-check"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statActive">0</div>
                <div class="stat-label">Học sinh đang học</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon orange">
                <i class="fa-solid fa-user-clock"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statRetained">0</div>
                <div class="stat-label">Học sinh bảo lưu</div>
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-icon teal">
                <i class="fa-solid fa-folder-open"></i>
            </div>
            <div class="stat-info">
                <div class="stat-value" id="statClasses">0</div>
                <div class="stat-label">Lớp học hiện có</div>
            </div>
        </div>
    </section>

    <!-- Search & Filter Card -->
    <section class="filter-card">
        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="searchInput" placeholder="Tìm kiếm theo Tên, Email hoặc SĐT...">
        </div>
        <div class="filter-group">
            <select id="filterClass" class="filter-select">
                <option value="">-- Chọn lớp học --</option>
            </select>
            <select id="filterStatus" class="filter-select">
                <option value="">-- Trạng thái --</option>
                <option value="active">Đang học</option>
                <option value="retained">Bảo lưu</option>
            </select>
            <button class="btn btn-secondary" id="btnResetFilters">
                <i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại
            </button>
        </div>
    </section>

    <!-- Main Content Table Card -->
    <main class="table-card">
        <div class="table-responsive">
            <table class="custom-table" id="studentTable">
                <thead>
                    <tr>
                        <th class="text-center">STT</th>
                        <th>Họ và tên</th>
                        <th>Lớp học</th>
                        <th>CCCD</th>
                        <th>Số điện thoại</th>
                        <th>Giới tính</th>
                        <th>Tỉnh</th>
                        <th>Email</th>
                        <th>Trạng thái</th>
                        <th style="width: 100px; text-align: right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="studentTableBody">
                    <!-- Hãy điền dữ liệu của bạn bằng JS tại đây -->
                </tbody>
            </table>
        </div>

        <!-- Empty State UI -->
        <div class="empty-state" id="emptyState">
            <div class="empty-state-icon">
                <i class="fa-regular fa-folder-open"></i>
            </div>
            <h3>Không tìm thấy học sinh</h3>
            <p>Không có kết quả nào phù hợp với bộ lọc tìm kiếm hiện tại.</p>
        </div>

      
    </main>
</div>

<!-- Student Form Modal (Used for both Create and Edit) -->
<div class="modal-overlay" id="studentModal">
    <div class="modal-box">
        <div class="modal-header">
            <h2 id="modalTitle">Thêm Mới Học Sinh</h2>
            <button class="modal-close" onclick="closeStudentModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        
        <form id="studentForm" novalidate>
            <input type="hidden" id="studentId" name="Id">
            <div class="modal-body">
                

                <div class="form-grid">
                    <div class="form-group col-12">
                        <label class="form-label">Ảnh đại diện</label>
                        <div class="avatar-upload-container">
                            <div class="avatar-preview-wrapper">
                                <img id="avatarPreview" alt="Avatar Preview">
                            </div>
                            <div class="avatar-upload-box" id="avatarUploadBox">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <p>Nhấp vào đây để chọn ảnh hoặc nhập đường dẫn ảnh bên dưới</p>
                                <input type="file" id="imageInput" accept="image/*" style="display: none;">
                            </div>
                        </div>
                        <input type="text" class="form-control" id="imagePath" placeholder="">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Họ và tên <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentName" required placeholder=" Nhập Họ và Tên">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Ngày sinh <span style="color:var(--danger)">*</span></label>
                        <div class="input-icon-wrapper">
                            <input type="text" class="form-control" id="studentBirthDay" required placeholder="Chọn ngày sinh...">
                            <i class="fa-regular fa-calendar input-icon"></i>
                        </div>
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Giới tính</label>
                        <select id="studentGender" name="Gender" class="form-control select2" required>
                            <option value="" disabled selected hidden>Chọn giới tính</option>
                            <option value="true">Nam</option>
                            <option value="false">Nữ</option>
                        </select>
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Số định danh / CCCD <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentCitizenId" required placeholder="Nhập CCCD">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Số điện thoại <span style="color:var(--danger)">*</span></label>
                        <input type="tel" class="form-control" id="studentPhone" required placeholder="Nhập số điện thoại">
                    </div>

                    <div class="form-group col-4">
                        <label class="form-label">Email <span style="color:var(--danger)">*</span></label>
                        <input type="email" class="form-control" id="studentEmail" required placeholder="Nhập Email">
                    </div>



                    <div class="form-group col-6">
                        <label class="form-label">Tỉnh / Thành phố <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentProvince" placeholder="Nhập tên thành phố">
                    </div>

                    <div class="form-group col-6">
                        <label class="form-label">Phường / Xã</label>
                        <input type="text" class="form-control" id="studentWard" placeholder="Nhập phường xã">
                    </div>

                    <div class="form-group col-12">
                        <label class="form-label">Địa chỉ cụ thể</label>
                        <input type="text" class="form-control" id="studentAddress" placeholder="Nhập địa chỉ">
                    </div>




                    <div class="form-group col-6">
                        <label class="form-label">Khóa học <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentCourse" required placeholder="Nhập khóa học">
                    </div>

                    <div class="form-group col-6">
                        <label class="form-label">Lớp học <span style="color:var(--danger)">*</span></label>
                        <input type="text" class="form-control" id="studentClassName" required placeholder="Nhập lớp học">
                    </div>

                    <div class="form-group col-12">
                        <label class="switch-container">
                            <input type="checkbox" class="switch-input" id="studentIsRetained">
                            <span class="switch-slider"></span>
                            <span class="form-label">Học sinh bảo lưu (Bảo lưu kết quả học tập)</span>
                        </label>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeStudentModal()">Hủy</button>
                <button type="submit" class="btn btn-primary" id="btnSubmitModal">Lưu thông tin</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        const modal = document.getElementById('studentModal');
        const studentForm = document.getElementById('studentForm');
        const avatarPreview = document.getElementById('avatarPreview');
        const imagePathInput = document.getElementById('imagePath');
        const imageInput = document.getElementById('imageInput');
        const uploadBox = document.getElementById('avatarUploadBox');
        var table = null;

        $(document).ready(function() {

            initDatePicker();
            initGenderSelect();
            initTable();
            initSearchEvent();

        });

            function initDatePicker() {
                flatpickr("#studentBirthDay", {
                    dateFormat: "d-m-Y",
                    allowInput: true,
                    parseDate: (datestr, format) => {
                        if (!datestr) return null;
                        const normalized = datestr.replace(/\//g, "-");
                        return flatpickr.parseDate(normalized, "d-m-Y");
                    }
                });
            }

            // Initialize Select2 Dropdown
            function initGenderSelect(){
                $('#studentGender').select2({
                    placeholder: "Chọn giới tính",
                    minimumResultsForSearch: -1,
                    width: '100%',
                    dropdownParent: $('#studentModal')
                });
            }

            
            function initSearchEvent(){

                $("#searchInput").on("keyup", function (e) {
                    if(e.key === "Enter"){
                        initTable();
                    }
                });
            }


            function initTable(){
                if(table) table.destroy();

                table = $("#studentTable").DataTable({
                    processing: true,
                    serverSide: true,
                    searching: false,
                    autoWidth: false,
                    lengthChange: true,
                    pageLength: 10,
                    lengthMenu: [10, 25, 50, 100],

                    // r + t ở trên, footer ở dưới gồm: length + info + pagination
                    dom: 'rt<"dt-custom-footer"<"dt-footer-left"l><"dt-footer-info"i><"dt-footer-right"p>>',

                    pagingType: "simple_numbers",

                    language: {
                        lengthMenu: "Hiển thị _MENU_ học sinh trên mỗi trang",
                        info: "Hiển thị từ học sinh thứ _START_ đến _END_ (Trong tổng số _TOTAL_ học sinh)",
                        emptyTable: "Không có học sinh nào trong danh sách",
                        infoEmpty: "Hiển thị 0 đến 0 của 0 học sinh",
                        infoFiltered: "",
                        paginate: {
                            first: "Đầu tiên",
                            last: "Cuối cùng",
                            next: "Trang sau",
                            previous: "Trang trước"
                        }
                    },

                    ajax: function (data,callback){
                        var payload = $.extend(true,{},data);
                        payload.Draw = data.draw;
                        payload.Start = data.start;
                        payload.Length = data.length;

                        if(data.order && data.order.length > 0){
                            payload.SortColumn = data.columns[data.order[0].column].data;
                            payload.SortDirection = data.order[0].dir;
                        }

                        payload.SearchText = $("#searchInput").val() || "";

                        $.ajax({
                            url: "/student/api/list-server-side",
                            type: "POST",
                            contentType: "application/json",
                            data: JSON.stringify(payload),
                            success: function (res){
                                callback(res);
                            },
                            error: function (xhr) {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Thất bại',
                                    text: "Đã xảy ra lỗi khi tải dữ liệu.",
                                    confirmButtonColor: '#d33',
                                    confirmButtonText: 'Đóng'
                                });

                                callback({
                                    draw: data.draw,
                                    recordsTotal:0,
                                    recordsFiltered: 0,
                                    data: []
                                });
                            }

                        });
                    },

                    columns: [
                        {
                            data:"id",
                            orderable: false,
                            render: function(d,t,row,meta){
                            return meta.row + meta.settings._iDisplayStart + 1;
                            }
                        },
                        { data: "name", orderable: true },
                        { data: "className", orderable: true },
                        { data: "citizenId", orderable: true },
                        { data: "phoneNumber", orderable: true },
                        { data: "genderText", orderable: false },
                        { data: "province", orderable: true },
                        { data: "email", orderable: true },
                        {
                            data: "isRetained",
                            orderable: true,
                            className: "text-center",
                            render: function (d) {
                                // Nếu bảo lưu (true) thì hiện nhãn đỏ, ngược lại hiện xanh đang học
                                return d 
                                    ? '<span class="badge bg-danger">Bảo lưu</span>' 
                                    : '<span class="badge bg-success">Đang học</span>';
                            }
                        },
                        {
                        data: "id",
                        orderable: false,
                        className: "text-center",
                        render: function (id) {
                            // Tạo 2 nút bấm Sửa và Xóa, truyền sẵn Id của học sinh đó vào hàm javascript
                            let actions = "<div class='d-flex justify-content-center align-items-center gap-2'>";

                            actions += `
                                <button type="button"
                                        onclick="editItem(${id})"
                                        class="btn-action btn-edit"
                                        title="Sửa">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                            `;

                            actions += `
                                <button type="button"
                                        onclick="deleteItem(${id})"
                                        class="btn-action btn-delete"
                                        title="Xóa">
                                    <i class="bi bi-trash"></i>
                                </button>
                            `;

                            actions += "</div>";

                            return actions;
                        }
                    }

                    ],
                    order: [[1, "asc"]]



                });
            }





        $(document).ready(function (){

             // Tắt validate mặc định của browser
            $("#studentForm").attr("novalidate", true);

            // Khi nhập/chọn lại thì xóa lỗi
            $("#studentForm").on("input change","input, select", function(){
                validateSingleField($(this));
            });

               // Khi người dùng nhấn nút "Lưu thông tin" (Submit Form)
        $("#studentForm").on("submit", function (e) {
            e.preventDefault(); // Chặn hành động tải lại trang mặc định

            // Kiểm tra validation ở client-side
            if (!validateStudentForm()) {
                return;
            }

            // Định dạng ngày sinh từ dd-mm-yyyy sang yyyy-mm-dd để khớp kiểu DateTime của Backend
            var birthDayRaw = $("#studentBirthDay").val();
            var birthDayISO = "";
            if (birthDayRaw) {
                var parts = birthDayRaw.split("-");
                if (parts.length === 3) {
                    birthDayISO = parts[2] + "-" + parts[1] + "-" + parts[0];
                }
            }

            // 1. Thu thập dữ liệu từ các ô nhập trong Modal của bạn
            var formData = {
                Name: $("#studentName").val().trim(),
                ClassName: $("#studentClassName").val().trim(),
                Image: $("#imagePath").val() ? $("#imagePath").val().trim() : "default-avatar.png", // Lấy đường dẫn ảnh
                Gender: $("#studentGender").val() === "true", // Chuyển chuỗi "true"/"false" sang kiểu bool
                Email: $("#studentEmail").val().trim(),
                BirthDay: birthDayISO, // Gửi định dạng YYYY-MM-DD
                CitizenId: $("#studentCitizenId").val().trim(),
                PhoneNumber: $("#studentPhone").val().trim(),
                Province: $("#studentProvince").val().trim(),
                Ward: $("#studentWard").val().trim(),
                Address: $("#studentAddress").val().trim(),
                Course: $("#studentCourse").val().trim(),
                IsRetained: $("#studentIsRetained").is(":checked")
            };

            // 2. Bắn Ajax gửi dữ liệu lên hàm POST /student/api/add
                $.ajax({
                    url: "/student/api/add",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(formData), // Đóng gói thành chuỗi JSON
                    success: function (response){
                        if(response.success){
                            Swal.fire({
                                icon: 'success',
                                title: 'Thành công',
                                text: response.message,
                                confirmButtonColor: '#3085d6',
                                confirmButtonText: 'OK'
                            }).then((result) => {
                                closeStudentModal();    // Đóng modal lại
                                location.reload();      // Tải lại trang để cập nhật danh sách mới
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Thất bại',
                                text: response.message,
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Đóng'
                            });
                        }
                    },
                    error: function (xhr) {
                        if (xhr.status === 400) {
                            Swal.fire({
                                icon: 'warning',
                                title: 'Dữ liệu không hợp lệ',
                                text: 'Vui lòng kiểm tra lại các trường bắt buộc!',
                                confirmButtonColor: '#f8bb86',
                                confirmButtonText: 'Đóng'
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Lỗi kết nối',
                                text: 'Đã xảy ra lỗi hệ thống hoặc không thể kết nối tới server.',
                                confirmButtonColor: '#d33',
                                confirmButtonText: 'Đóng'
                            });
                        }
                        console.log(xhr.responseText);
                    }
                        })

            })
        } );




        function validateStudentForm(){
            var isValid = true;
            var requiredFields = [
                "#studentName",
                "#studentBirthDay",
                "#studentGender",
                "#studentCitizenId",
                "#studentPhone",
                "#studentEmail",
                "#studentCourse",
                "#studentClassName",
                "#studentProvince"
            ];

            requiredFields.forEach(function(selector){
                var field = $(selector);
                var fieldValid = validateSingleField(field);
                if(!fieldValid){
                    isValid = false;
                }
            });

            return isValid;

        };

        function validateSingleField(field) {
            clearFieldError(field);

            var value = field.val();

            if (value === null || value === undefined || value.toString().trim() === "") {
                var label = getFieldLabel(field);
                showFieldError(field, "Vui lòng nhập " + label);
                return false;
            }

            // Validate email
            if (field.attr("id") === "studentEmail") {
                    var emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

                if (!emailRegex.test(value.trim())) {
                    showFieldError(field, "Email không đúng định dạng");
                    return false;
                }
            }

            // Validate số điện thoại Việt Nam
            if (field.attr("id") === "studentPhone") {
                var phoneRegex = /^(0|\+84)[0-9]{9}$/;

                if (!phoneRegex.test(value.trim())) {
                    showFieldError(field, "Số điện thoại không đúng định dạng");
                    return false;
                }
            }

            // Validate CCCD
            if (field.attr("id") === "studentCitizenId") {
                var citizenRegex = /^[0-9]{9,12}$/;

                if (!citizenRegex.test(value.trim())) {
                    showFieldError(field, "Số định danh/CCCD phải từ 0 đến 12 chữ số");
                    return false;
                }
            }

            // Validate ngày sinh dd-mm-yyyy
            if (field.attr("id") === "studentBirthDay") {
                var dateRegex = /^(0[1-9]|[12][0-9]|3[01])-(0[1-9]|1[0-2])-[0-9]{4}$/;

                if (!dateRegex.test(value.trim())) {
                    showFieldError(field, "Ngày sinh phải có định dạng dd-mm-yyyy");
                    return false;
                }
            }

            return true;
        }

        function clearStudentFormErrors() {
            var form = $("#studentForm");

            form.find(".is-invalid").removeClass("is-invalid");
            form.find(".field-error").remove();

            // Nếu có select2
            form.find(".select2-container").removeClass("is-invalid");
        }



        function showFieldError(field, message) {
            var formGroup = field.closest(".form-group");

            field.addClass("is-invalid");

            // Nếu là select2
            if (field.hasClass("select2")) {
                formGroup.find(".select2-container").addClass("is-invalid");
            }

            formGroup.append('<div class="field-error">' + message + '</div>');
        }

        function clearFieldError(field) {
            var formGroup = field.closest(".form-group");

            field.removeClass("is-invalid");
            formGroup.find(".field-error").remove();

            // Nếu là select2
            if (field.hasClass("select2")) {
                formGroup.find(".select2-container").removeClass("is-invalid");
            }
        }

        function getFieldLabel(field) {
            var formGroup = field.closest(".form-group");
            var label = formGroup.find(".form-label").first().text();

            return label.replace("*", "").trim() || "trường này";
        }



        // Toggle Modal
        function openAddModal() {
            studentForm.reset();
            $('#studentGender').val(null).trigger('change');
            document.getElementById('studentId').value = '';
            document.getElementById('modalTitle').textContent = 'Thêm Mới Học Sinh';
            document.getElementById('btnSubmitModal').textContent = 'Lưu thông tin';
            avatarPreview.src = "";

            modal.classList.add('open');
            clearStudentFormErrors();
        }

        function closeStudentModal() {
            modal.classList.remove('open');
            clearStudentFormErrors();
        }

        function openEditModal(studentId) {
            studentForm.reset();
            $('#studentGender').val(null).trigger('change');
            document.getElementById('studentId').value = studentId;
            document.getElementById('modalTitle').textContent = 'Cập Nhật Thông Tin Học Sinh';
            document.getElementById('btnSubmitModal').textContent = 'Cập nhật';
            avatarPreview.src = "";
            
            modal.classList.add('open');
            clearStudentFormErrors();
        }

        // Avatar Preview URL Listener
        imagePathInput.addEventListener('input', (e) => {
            const val = e.target.value.trim();
            avatarPreview.src = val !== "" ? val : "";
        });

        // Click Upload Box triggers file input
        uploadBox.addEventListener('click', () => {
            imageInput.click();
        });

        // Avatar Local File Selection Preview
        imageInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    avatarPreview.src = evt.target.result;
                    imagePathInput.value = evt.target.result; // Put base64 in text input for form data collection
                }
                reader.readAsDataURL(file);
            }
        });
    </script>
}
